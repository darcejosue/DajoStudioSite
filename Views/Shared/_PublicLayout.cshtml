<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Centro de Descargas</title>
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Light Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Public Minimal Header (No Admin Nav Links) -->
    <header class="navbar-custom">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="nav-brand">
                <div class="brand-icon">
                    <i class="bi bi-cloud-arrow-down-fill"></i>
                </div>
                <div>
                    <span>DajoStudio</span>
                    <span style="font-size: 0.8rem; font-weight: 500; display: block; color: #38bdf8;">Centro Oficial de Descargas</span>
                </div>
            </div>
            
            <div class="d-flex align-items-center text-white small">
                <span class="badge badge-active"><i class="bi bi-shield-check me-1"></i> Servidor Verificado</span>
            </div>
        </div>
    </header>

    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container text-center text-muted small py-2">
            &copy; @DateTime.UtcNow.Year DajoStudio &bull; Servidor de Descargas Oficiales del Sistema
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function copyToClipboard(text, btnElement) {
            navigator.clipboard.writeText(text).then(() => {
                const originalHtml = btnElement.innerHTML;
                btnElement.innerHTML = '<i class="bi bi-check2 text-success"></i> ¡Copiado!';
                setTimeout(() => {
                    btnElement.innerHTML = originalHtml;
                }, 2000);
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
