<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DajoStudio UpdateServer</title>
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Light Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-custom">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">
                    <i class="bi bi-cloud-arrow-up-fill"></i>
                </div>
                <div>
                    <span>DajoStudio</span>
                    <span style="font-size: 0.8rem; font-weight: 500; display: block; color: #38bdf8;">Update Server</span>
                </div>
            </a>
            
            <nav class="d-flex gap-2 align-items-center">
                <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-fill me-1"></i> Dashboard
                </a>
                <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Upload" ? "active" : "")" 
                   asp-controller="Home" asp-action="Upload">
                    <i class="bi bi-plus-circle-fill me-1"></i> Subir Actualización
                </a>
                <a class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "IntegrationGuide" ? "active" : "")" 
                   asp-controller="Home" asp-action="IntegrationGuide">
                    <i class="bi bi-code-slash me-1"></i> Guía C# Client
                </a>
            </nav>
        </div>
    </header>

    <main class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show glass-card border-0 mb-4" role="alert" style="background: #f0fdf4; border-left: 4px solid #16a34a !important;">
                <div class="d-flex align-items-center gap-2 text-dark">
                    <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                    <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer>
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                &copy; @DateTime.UtcNow.Year DajoStudio Update Server &bull; Servidor de Instaladores de Alto Volumen (~250 MB+)
            </div>
            <div class="d-flex gap-3">
                <span class="badge badge-active"><i class="bi bi-hdd-network-fill me-1"></i> Servidor Activo</span>
                <span class="text-white small"><i class="bi bi-shield-check me-1 text-success"></i> Checksum SHA256</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function copyToClipboard(text, btnElement) {
            navigator.clipboard.writeText(text).then(() => {
                const originalHtml = btnElement.innerHTML;
                btnElement.innerHTML = '<i class="bi bi-check2 text-success"></i> ¡Copiado!';
                setTimeout(() => {
                    btnElement.innerHTML = originalHtml;
                }, 2000);
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
